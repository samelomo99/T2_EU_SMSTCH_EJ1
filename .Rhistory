colorNA = "grey90",
border.col = "grey40",
lwd = 0.5,
showNA = FALSE
) +
tm_layout(
main.title = "Cambio porcentual del número per cápita de restaurantes",
legend.outside = TRUE,
legend.text.size = 0.8,
frame = FALSE
)
